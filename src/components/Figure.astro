---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  variant?: 'default' | 'narrow' | 'cover';
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  width,
  height,
  variant = 'default',
  priority = false,
  class: className,
} = Astro.props;
---

<figure class:list={['wiki-figure', `is-${variant}`, className]}>
  <div class="media">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .wiki-figure {
    max-width: 100%;
    margin: 1.6rem 0 2rem;
  }

  .media {
    max-width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.05);
  }

  img {
    display: block;
    max-width: 100%;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .is-narrow {
    max-width: 26rem;
    margin-inline: auto;
  }

  .is-cover .media {
    padding: 0;
    overflow: hidden;
  }

  .is-cover img {
    border-radius: 11px;
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 44rem) {
    .media {
      padding: 0.35rem;
      border-radius: 10px;
    }

    .is-cover .media {
      padding: 0;
    }
  }
</style>
