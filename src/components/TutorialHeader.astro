---
interface Props {
  difficulty?: 'Beginner' | 'Intermediate' | 'Advanced';
  time?: string;
  prerequisites?: string[];
  parts?: string[];
  status?: 'draft' | 'reviewed';
  note?: string;
}

const {
  difficulty = 'Beginner',
  time,
  prerequisites = [],
  parts = [],
  status = 'draft',
  note,
} = Astro.props;

const statusLabel =
  status === 'reviewed' ? 'Reviewed' : 'Draft — not yet verified';
---

<section class="tutorial-header" aria-label="Tutorial overview">
  <p class="kicker">Tutorial</p>

  <dl class="facts">
    <div class="fact">
      <dt>Difficulty</dt>
      <dd>{difficulty}</dd>
    </div>
    {
      time && (
        <div class="fact">
          <dt>Estimated time</dt>
          <dd>{time}</dd>
        </div>
      )
    }
    <div class="fact">
      <dt>Verification status</dt>
      <dd class:list={['status', status]}>{statusLabel}</dd>
    </div>
  </dl>

  {
    (prerequisites.length > 0 || parts.length > 0) && (
      <div class="columns">
        {prerequisites.length > 0 && (
          <div>
            <h2>Prerequisites</h2>
            <ul>
              {prerequisites.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        {parts.length > 0 && (
          <div>
            <h2>Parts used</h2>
            <ul>
              {parts.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }

  {note && <p class="note">{note}</p>}
</section>

<style>
  .tutorial-header {
    margin-block: 1.75rem 2.25rem;
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-left: 5px solid var(--el-orange);
    border-radius: 0 12px 12px 0;
    background: var(--sl-color-bg);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.04);
  }

  .kicker {
    margin: 0 0 0.65rem;
    color: var(--sl-color-text-accent);
    font-family: var(--el-font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    margin: 0;
  }

  .fact {
    display: grid;
    gap: 0.1rem;
  }

  dt {
    color: var(--sl-color-gray-3);
    font-family: var(--el-font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--el-orange);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem 2rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  h2 {
    margin: 0 0 0.4rem;
    color: var(--sl-color-gray-3);
    font-family: var(--el-font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  li {
    margin-block: 0.2rem;
    color: var(--sl-color-gray-2);
  }

  .note {
    margin: 1rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
</style>
